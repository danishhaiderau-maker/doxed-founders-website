{
  "name": "founder-ide-extension",
  "displayName": "Founder",
  "description": "The Founder control surface for identity, local infrastructure, AI routing, and remote development.",
  "version": "0.4.0",
  "publisher": "doxxedcrypto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danishhaiderau-maker/doxedcryptofounder.git",
    "directory": "packages/founder-ide-extension"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": ["Chat", "AI", "Machine Learning", "Other"],
  "keywords": ["ai", "chat", "founder-os", "openai-compatible", "llm"],
  "main": "./out/extension.js",
  "exports": {
    "./ipc": {
      "types": "./src/ipc/protocol.ts",
      "default": "./out/ipc/protocol.js"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "authentication": [
      {
        "id": "founderOs",
        "label": "Founder"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "founderOs",
          "title": "Founder",
          "icon": "resources/founder.svg"
        }
      ]
    },
    "views": {
      "founderOs": [
        {
          "id": "founderOs.hub",
          "name": "Founder",
          "type": "webview"
        },
        {
          "id": "founderOs.companion",
          "name": "Dragon",
          "type": "webview",
          "when": "config.founderOs.companion.enabled"
        },
        {
          "id": "founderOs.agents",
          "name": "Agents",
          "visibility": "collapsed"
        },
        {
          "id": "founderOs.ship",
          "name": "Ship",
          "visibility": "collapsed"
        },
        {
          "id": "founderOs.node",
          "name": "Founder Node",
          "visibility": "collapsed"
        },
        {
          "id": "founderOs.connections",
          "name": "Connections",
          "visibility": "collapsed"
        },
        {
          "id": "founderOs.remote",
          "name": "Remote Sessions",
          "visibility": "collapsed"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "founder-os.chat",
        "name": "FounderOS",
        "description": "Chat with the Founder OS AI Gateway (routed via your node)",
        "commands": [
          {
            "name": "code",
            "description": "Optimize for coding (founder-os-code / Turbo profile)"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "founder-edit-file",
        "displayName": "Edit File",
        "modelDescription": "Edit a file in the workspace by replacing oldText with newText. Use absolute paths. Set createIfMissing=true to create the file if it does not exist. The change is applied via vscode.workspace.applyEdit and is reviewable in the editor.",
        "userDescription": "Edit or create a workspace file (Founder OS)",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "editFile",
        "icon": "$(edit)",
        "tags": ["founder-os", "file-edit"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Absolute or workspace-relative path of the file to edit."
            },
            "oldText": {
              "type": "string",
              "description": "The exact text to replace. Empty string means append to end of file."
            },
            "newText": {
              "type": "string",
              "description": "The new text to insert in place of oldText."
            },
            "createIfMissing": {
              "type": "boolean",
              "description": "If true, create the file when it does not exist.",
              "default": false
            }
          },
          "required": ["filePath", "oldText", "newText"]
        }
      },
      {
        "name": "founder-run-command",
        "displayName": "Run Command",
        "modelDescription": "Run a shell command in a VS Code terminal and return its combined stdout+stderr output. The command runs in the workspace root by default. Use for build, test, lint, and inspection commands. Confirm with the user before destructive commands.",
        "userDescription": "Run a terminal command and capture output (Founder OS)",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "runCommand",
        "icon": "$(terminal)",
        "tags": ["founder-os", "terminal"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "The shell command to execute."
            },
            "cwd": {
              "type": "string",
              "description": "Optional working directory (absolute or workspace-relative). Defaults to the workspace root."
            },
            "timeoutMs": {
              "type": "number",
              "description": "Max milliseconds to wait for completion. Default 30000, max 300000.",
              "default": 30000
            }
          },
          "required": ["command"]
        }
      },
      {
        "name": "founder-read-workspace",
        "displayName": "Read Workspace",
        "modelDescription": "Walk the current workspace file tree and return a compact summary (respecting common ignore patterns like node_modules and .git). Optionally include the full contents of a small set of files via readFiles. Use this to ground yourself in the repo structure before editing.",
        "userDescription": "Read the workspace file tree (Founder OS)",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "readWorkspace",
        "icon": "$(folder-opened)",
        "tags": ["founder-os", "workspace"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "subdir": {
              "type": "string",
              "description": "Optional workspace-relative sub-directory to walk. Defaults to the workspace root."
            },
            "readFiles": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Optional list of workspace-relative files whose full contents to include (max 10)."
            },
            "maxTreeEntries": {
              "type": "number",
              "description": "Max file-tree entries to return. Default 400, max 5000.",
              "default": 400
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "founderOs.manage",
        "title": "Founder OS: Manage connection"
      },
      {
        "command": "founderOs.signIn",
        "title": "Founder: Sign in with X"
      },
      {
        "command": "founderOs.signOut",
        "title": "Founder: Sign out"
      },
      {
        "command": "founderOs.pair",
        "title": "Founder OS: Connect this Founder IDE"
      },
      {
        "command": "founderOs.connectFounderOs",
        "title": "Founder OS: Reconnect Founder OS"
      },
      {
        "command": "founderOs.selectModel",
        "title": "Founder OS: Select model alias"
      },
      {
        "command": "founderOs.selectProfile",
        "title": "Founder OS: Select execution profile"
      },
      {
        "command": "founderOs.showCostBreakdown",
        "title": "Founder OS: Show DDollar cost breakdown"
      },
      {
        "command": "founderOs.resetCost",
        "title": "Founder OS: Reset DDollar session counter"
      },
      {
        "command": "founderOs.openVaultConfig",
        "title": "Founder OS: Open node-config.json"
      },
      {
        "command": "founderOs.showGatewayMetadata",
        "title": "Founder OS: Show gateway metadata output channel"
      },
      {
        "command": "founderOs.recentGatewayMetadata",
        "title": "Founder OS: Recent gateway requests"
      },
      {
        "command": "founderOs.openHub",
        "title": "Founder: Open control center"
      },
      {
        "command": "founderOs.openAgents",
        "title": "Founder: Open Agents"
      },
      {
        "command": "founderOs.openCompanion",
        "title": "Founder: Open Dragon"
      },
      {
        "command": "founderOs.openShip",
        "title": "Founder: Open Ship"
      },
      {
        "command": "founderOs.openNodeView",
        "title": "Founder: Open Founder Node"
      },
      {
        "command": "founderOs.openConnectionsView",
        "title": "Founder: Open Connections"
      },
      {
        "command": "founderOs.openRemoteView",
        "title": "Founder: Open Remote Sessions"
      },
      {
        "command": "founderOs.openRemoteControl",
        "title": "Founder: Open web remote control"
      },
      {
        "command": "founderOs.openChat",
        "title": "Founder: Open chat"
      },
      {
        "command": "founderOs.openConnections",
        "title": "Founder: Manage connections"
      },
      {
        "command": "founderOs.openSettings",
        "title": "Founder: Open settings"
      },
      {
        "command": "founderOs.refreshHub",
        "title": "Refresh Founder",
        "icon": "$(refresh)"
      },
      {
        "command": "founderOs.refreshShortcuts",
        "title": "Refresh Founder shortcuts",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "founderOs.refreshHub",
          "when": "view == founderOs.hub",
          "group": "navigation"
        },
        {
          "command": "founderOs.refreshShortcuts",
          "when": "view == founderOs.agents || view == founderOs.ship || view == founderOs.node || view == founderOs.connections || view == founderOs.remote",
          "group": "navigation"
        }
      ],
      "menubar/preferences": [
        {
          "command": "founderOs.openSettings",
          "group": "1_founder@1"
        }
      ]
    },
    "configuration": {
      "title": "Founder OS",
      "properties": {
        "founderOs.workspaceMode": {
          "type": "string",
          "enum": [
            "local",
            "hybrid",
            "cloud"
          ],
          "enumItemLabels": [
            "Local",
            "Hybrid",
            "Founder Cloud"
          ],
          "default": "hybrid",
          "description": "Where this workspace runs and which connected services it may use."
        },
        "founderOs.companion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Founder Dragon companion in the Founder sidebar."
        },
        "founderOs.apiBaseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional override for the Founder OS API base URL. If empty, the extension reads `apiBaseUrl` from `~/FounderVault/node-config.json`."
        },
        "founderOs.nodeId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional override for the local relay ID. If empty, Founder IDE reads `nodeId` from `~/FounderVault/node-config.json`."
        },
        "founderOs.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "markdownDescription": "Per-request timeout in milliseconds for gateway calls (including streaming)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "package": "vsce package --no-yarn --no-dependencies",
    "lint": "echo 'no lint configured'",
    "test": "tsx --test src/embedded-relay.spec.ts src/founder-hub-state.spec.ts src/founder-shortcuts-state.spec.ts src/manifest.spec.ts src/ipc/protocol.spec.ts src/ipc/server.spec.ts src/gateway-client.spec.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "1.99.1",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.8.3"
  }
}
