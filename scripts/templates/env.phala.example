# Copy to ../doxedcryptofounder-secrets/vault/.env.phala (never commit).

# Phala Cloud deploy token — https://cloud.phala.network/dashboard/tokens
PHALA_CLOUD_API_KEY=

# Public HTTPS base from Phala INGRESS (auto-filled by npm run deploy:phala-cvm)
# https://abc123def456-8080.dstack-prod5.phala.network
PHALA_CVM_BASE_URL=

# Same value as Railway JWT_SECRET (required for /secrets/unwrap in TEE)
JWT_SECRET=

# Redpill / Phala platform inference (Builder → Phala Private AI)
PHALA_API_KEY=
PHALA_INFERENCE_URL=https://api.redpill.ai/v1
PHALA_MODEL=phala/deepseek-chat-v3-0324

# Bearer token the API uses when calling your CVM (set same on Phala Encrypted Secrets)
PHALA_CVM_API_KEY=

# Optional slug shown in backup receipts
PHALA_CVM_WORKLOAD_ID=doxxedcrypto-founder-cvm

# Railway GraphQL token (or use vault/.env.x.secrets RAILWAY_TOKEN)
RAILWAY_TOKEN=
