services/btc-conservative-agent/bot_analyzer_sync.json
services/btc-conservative-agent/repo_version_sync.json
services/btc-conservative-agent/bitfinex_live_state.json
# Broad catch for all remaining runtime output (source .py files NOT affected)
services/btc-conservative-agent/*.json
