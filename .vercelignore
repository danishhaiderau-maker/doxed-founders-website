# Founder IDE upstream — git submodule, huge
packages/founder-ide/
packages/skycode-fork/

# API / founder-node source — not needed for web deploy
# BUT keep package.json + tsconfig so npm workspaces resolve correctly
apps/api/src/
apps/api/nest-cli.json
apps/api/.env*
apps/founder-node/src/
apps/founder-node/release/
apps/founder-node/build/
apps/founder-node/.env*

# Root-level analysis artifacts (JSON/CSV/DB dumps)
/*_report.json
/*_summary.json
/*_audit.json
/*_validation.json
/*_sync.json
/*_integrity.json
/*_session.json
/*_study.jsonl
/*_drift_report.json
/*_analysis.json
/*_specs.json
/*.csv
/*.jsonl
/*.db

# Scripts — only keep vercel-ignore-build.sh
scripts/*
!scripts/vercel-ignore-build.sh

# Root documentation artifacts are not needed by the web bundle. Anchor this
# pattern so it cannot exclude the Next.js route at apps/web/src/app/docs/.
/docs/

