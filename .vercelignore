# Python bots / research (not used by Next.js deploy)
services/btc-conservative-agent/
services/btc-signal-engine/

# Local-only research snapshots
.edge-analysis/
.agent-check*.json
.dash-check.json
.dash-live.json

services/btc-conservative-agent/research_session_archives/
services/btc-conservative-agent/research/downloads/
