# Paste these into Railway API service Variables (one-time), then redeploy.
# Or run: railway login && npm run apply:railway-x
#
# TWITTER_ACCESS_TOKEN + TWITTER_ACCESS_TOKEN_SECRET:
#   X Developer Portal -> Keys -> generate Access Token for @Bitbro4crypto (Read+Write)

TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
X_BRAND_HANDLE=Bitbro4crypto
PUBLIC_SITE_URL=https://doxxedcrypto.digital
TRENDING_BUY_MIN_TRADERS=5
TRADER_WIN_MIN_PNL_PERCENT=50
ADMIN_SYNC_JWT=
