# Copy this file to .env.neon and paste your Neon connection string.
# Get it from: https://console.neon.tech -> your project -> Connect
#
# Example:
# DATABASE_URL="postgresql://myuser:mypassword@ep-cool-name-12345678.us-east-1.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
