  query     String
  results   Int      @default(0)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
}

model TrendingScore {
  id        String   @id @default(cuid())
  projectId String   @unique
  score     Decimal  @db.Decimal(16, 6)
