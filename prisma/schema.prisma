// ─── Founder Agents (Phase 3) ──────────────────────────────────────────────────

model FounderAgent {
  id             String                 @id @default(cuid())
  slug           String                 @unique
  founderId      String
  projectId      String?
  creatorUserId  String
  name           String
  description    String?                @db.Text
  category       AgentCategory
  template       AgentWorkforceTemplate @default(CUSTOM)
  isPublic       Boolean                @default(true)
  config         Json?
  followerCount  Int                    @default(0)
  usageCount     Int                    @default(0)
  ratingSum      Int                    @default(0)
  ratingCount    Int                    @default(0)
  revenueCredits Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  founder Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator User     @relation("AgentCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  installs AgentInstall[]
  runs     AgentRun[]
  followers AgentFollow[]

  @@index([founderId])
  @@index([projectId])
  @@index([category])
  @@index([usageCount(sort: Desc)])
}

model AgentInstall {
  id          String   @id @default(cuid())
  agentId     String
  userId      String
  projectId   String?
  config      Json?
  installedAt DateTime @default(now())

  agent FounderAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@index([userId])
}

model AgentRun {
  id           String         @id @default(cuid())
  agentId      String
  userId       String
  inputPrompt  String?        @db.Text
  output       Json?
  status       AgentRunStatus @default(COMPLETED)
  creditsSpent Int            @default(0)
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  agent FounderAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildQueueItems BuildQueueItem[]

  @@index([agentId])
  @@index([userId])
}

model AgentFollow {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  createdAt DateTime @default(now())

  agent FounderAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@index([userId])
}

// ─── Account Security ──────────────────────────────────────────────────────────

model UserTotp {
  id              String    @id @default(cuid())
  userId          String    @unique
  secretEncrypted String    @db.Text
  enabled         Boolean   @default(false)
  enabledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    String   @db.Text
  counter      BigInt   @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String?
  label        String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletConnection {
  id         String    @id @default(cuid())
  userId     String
  chain      ChainSlug @default(SOLANA)
  address    String
  verifiedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain])
  @@index([address])
}

model AuthPendingChallenge {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  kind      String
  payload   Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── API Cache ─────────────────────────────────────────────────────────────────

model ApiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
