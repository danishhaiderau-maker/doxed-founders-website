generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ChainSlug {
  ETHEREUM
  SOLANA
  POLYGON
  ARBITRUM
  OPTIMISM
  BASE
  AVALANCHE
  BNB_CHAIN
}

enum ListingStatus {
  COMMUNITY_VOTING
  PENDING
  APPROVED
  REJECTED
}

enum ListingVoteValue {
  YES
  NO
}

enum VerificationType {
  IDENTITY
  LINKEDIN
  GITHUB
  KYC
  AUDIT
  TEAM_DOXXED
}

enum AnalyticsEventType {
  PAGE_VIEW
  SEARCH
  WATCHLIST_ADD
  WATCHLIST_REMOVE
  PAPER_TRADE_BUY
  PAPER_TRADE_SELL
  PROJECT_CLICK
}

enum PaperTradeSide {
  BUY
  SELL
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum ProjectSource {
  CURATED
  DYNAMIC
}

enum FounderPresenceLevel {
  UNVERIFIED
  PUBLIC_FOUNDER
  VERIFIED_BUILDER
  TRANSPARENT_FOUNDER
  PROVEN_FOUNDER
}

enum FounderVideoType {
  INTRODUCTION
  DEEP_DIVE
  MONTHLY_UPDATE
  QA
}

enum FounderJourneyStage {
  IDEA
  PROTOTYPE
  MVP
  BETA
  DEMAND_VALIDATED
  LAUNCH
  REVENUE
}

enum DemandPollType {
  WOULD_USE
  WOULD_PAY
  TOKEN_INTEREST
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum SimulatedRaiseStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectLifecycleStage {
  IDEA
  BRAINSTORMING
  PROTOTYPE
  MVP
  BETA
  DEMAND_VALIDATION
  SIMULATED_RAISE
  LAUNCH_READY
  TOKEN_LAUNCH
  LIVE_TRADING
}

enum UserProgressTier {
  EXPLORER
  TRADER
  COMMUNITY_CONTRIBUTOR
  FOUNDER_IDEA
  FOUNDER_BUILDING
  LAUNCH_CANDIDATE
  PROVEN_FOUNDER
}

enum FounderApplicationStatus {
  DRAFT
  SUBMITTED
  ACTIVE
  REJECTED
}

enum BountyStatus {
  OPEN
  AWARDED
  CANCELLED
}

enum UserBadgeKind {
  EARLY_SCOUT
  CONNECTOR
  HELPFUL_CONTRIBUTOR
  ANALYST
}

enum SuggestedUpdateStatus {
  PENDING
  PUBLISHED
  DISMISSED
}

enum AgentCategory {
  RESEARCH
  TRADING
  COMMUNITY
  SUPPORT
  MARKETING
  TOKENOMICS
  AUDIT
  BUILDER
  FUNDRAISING
  LAUNCH
}

enum AgentWorkforceTemplate {
  PRODUCT_MANAGER
  RESEARCHER
  BUILDER
  MARKETER
  COMMUNITY_MANAGER
  FUNDRAISING
  LAUNCH
  CUSTOM
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BuildQueueItemKind {
  IDEA
  TASK
  GITHUB_ISSUE
  ROADMAP
  SPEC
}

enum BuildQueueStatus {
  CAPTURED
  SPECCED
  QUEUED
  IN_PROGRESS
  BLOCKED
  DONE
  DISMISSED
}

enum BuildQueueSource {
  QUICK_BUILD
  VOICE
  AGENT
  COMMAND_BAR
  MANUAL
  BUILD_ROOM
}

enum AiProvider {
  RULE_BASED
  OPENAI
  ANTHROPIC
  GEMINI
  OPENHANDS
  CURSOR
  CLAUDE_CODE
  CODEX
  WINDSURF
  OPENCLAW
}

enum FounderEventType {
  GITHUB_COMMIT
  GITHUB_PR_MERGED
  GITHUB_ISSUE_CREATED
  DEPLOY_SUCCESS
  DEPLOY_STARTED
  BUILD_QUEUE_CAPTURED
  BUILD_PUBLISHED
  AGENT_RUN_COMPLETE
  CURSOR_BUILD_SESSION
  COMMUNITY_ACTIVITY
  QUICK_COMMAND
  COPILOT_COMMAND
  RAISE_ALLOCATION
  WALLET_CONNECTED
  SCOUT_MARKET_STAKE
}

enum FounderEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  twitterHandle String?
  role          UserRole  @default(USER)
  emailVerified DateTime?
  banned        Boolean   @default(false)
  bannedReason  String?
  reputationPoints Int    @default(0)
  contributorLevel Int    @default(1)
  progressTier     UserProgressTier @default(EXPLORER)
  notificationPrefs Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  watchlists           Watchlist[]
  paperPortfolio       PaperPortfolio?
  paperTrades          PaperTrade[]
  feedPosts            FeedPost[]
  feedComments         FeedComment[]
  listingApplications  ListingApplication[]
  listingVotes         ListingVote[]
  analyticsEvents      AnalyticsEvent[]
  searchLogs           SearchLog[]
  adminActions         AdminAction[]        @relation("AdminActions")
  leaderboardEntries   LeaderboardEntry[]
  oauthAccounts        OAuthAccount[]
  notifications        Notification[]
  founder              Founder?
  raiseAllocations     RaiseAllocation[]
  demandPollVotes      DemandPollVote[]
  projectFollows       ProjectFollow[]
  founderApplications  FounderApplication[]
  economyEvents        VirtualEconomyEvent[]
  reputationAwards     ReputationAward[]
  pointLedger          PointLedger[]
  following            UserFollow[] @relation("UserFollowing")
  followers            UserFollow[] @relation("UserFollowers")
  engagementLotteryWins EngagementLotteryWinner[]
  helpfulMarksGiven    HelpfulMark[] @relation("HelpfulMarker")
  helpfulMarksReceived HelpfulMark[] @relation("HelpfulRecipient")
  userBadges           UserBadge[]
  scoutMarketPositions ScoutMarketPosition[]
  githubConnection     GitHubConnection?
  connectedApps           ConnectedAppStatus[]
  integrationCredentials  IntegrationCredential[]
  cursorBuildSessions     CursorBuildSession[]
  founderCreditLedger  FounderCreditLedger[]
  bountyAwards         FounderBounty[] @relation("BountyAwardee")
  earlyScouts          EarlyScoutRecord[]
  totp                 UserTotp?
  webAuthnCredentials  WebAuthnCredential[]
  recoveryCodes        RecoveryCode[]
  walletConnections    WalletConnection[]
  authPendingChallenges AuthPendingChallenge[]
  createdAgents        FounderAgent[] @relation("AgentCreator")
  agentInstalls        AgentInstall[]
  agentRuns            AgentRun[]
  agentFollows         AgentFollow[]
  builderSettings      FounderBuilderSettings?
  founderEvents        FounderEvent[]

  @@index([email])
  @@index([role])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerId        String
  accessToken       String?  @db.Text
  accessTokenSecret String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// ─── Chains & Categories ─────────────────────────────────────────────────────

model Chain {
  id        String    @id @default(cuid())
  slug      ChainSlug @unique
  name      String
  iconUrl   String?
  createdAt DateTime  @default(now())

  projects Project[]
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())

  projects Project[]
}

// ─── Founders ────────────────────────────────────────────────────────────────

model Founder {
  id                  String               @id @default(cuid())
  slug                String               @unique
  userId              String?              @unique
  name                String
  bio                 String?              @db.Text
  photoUrl            String?
  linkedInUrl         String?
  twitterUrl          String?
  githubUrl           String?
  githubUsername      String?
  websiteUrl          String?
  videoUrl            String?
  presenceLevel       FounderPresenceLevel @default(UNVERIFIED)
  journeyStage        FounderJourneyStage  @default(IDEA)
  reputationScore     Int                  @default(0)
  buildStreakDays     Int                  @default(0)
  founderCredits      Int                  @default(0)
  githubRepoFullName  String?
  lastBuildPostAt     DateTime?
  publicBuildingSince DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  projects           Project[]
  verifications      FounderVerification[]
  founderUpdates     FounderUpdate[]
  videos             FounderVideo[]
  buildPosts         FounderBuildPost[]
  creditLedger     FounderCreditLedger[]
  suggestedUpdates    SuggestedBuildUpdate[]
  cursorBuildSessions CursorBuildSession[]
  agents              FounderAgent[]
  buildQueueItems     BuildQueueItem[]
  founderEvents       FounderEvent[]
}

model FounderVerification {
  id         String           @id @default(cuid())
  founderId  String
  type       VerificationType
  verified   Boolean          @default(false)
  verifiedAt DateTime?
  notes      String?
  createdAt  DateTime         @default(now())

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@unique([founderId, type])
  @@index([founderId])
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  ticker          String
  description     String?       @db.Text
  summary         String?       @db.Text
  logoUrl         String?
  websiteUrl      String?
  docsUrl         String?
  whitepaperUrl   String?
  contractAddress String?
  dexscreenerUrl  String?
  chainId         String
  categoryId      String?
  founderId       String?
  source          ProjectSource @default(CURATED)
  trackingActive  Boolean       @default(true)
  lastTradeAt     DateTime?
  featured        Boolean       @default(false)
  approved        Boolean       @default(false)
  lifecycleStage  ProjectLifecycleStage @default(IDEA)
  launchReadiness Int           @default(0)
  plannedLaunchDate DateTime?
  launchRequestedAt DateTime?
  isLiveToken     Boolean       @default(false)
  launchPriceUsd  Decimal?      @db.Decimal(24, 12)
  bubbleScore     Int           @default(0)
  communityRewardPool Int       @default(10000)
  githubRepoFullName  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  chain    Chain     @relation(fields: [chainId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  founder  Founder?  @relation(fields: [founderId], references: [id])

  metrics       ProjectMetrics?
  socials       ProjectSocials?
  documents     ProjectDocument[]
  watchlists    Watchlist[]
  paperTrades    PaperTrade[]
  paperPositions PaperPosition[]
  feedPosts      FeedPost[]
  featuredEntry  FeaturedProject?
  auditReports  AuditReport[]
  trendingScore TrendingScore?
  analyticsEvents AnalyticsEvent[]
  founderUpdates FounderUpdate[]
  roadmapItems   ProjectRoadmapItem[]
  simulatedRaises SimulatedRaise[]
  demandPolls    DemandPoll[]
  founderVideos  FounderVideo[]
  buildPosts     FounderBuildPost[]
  followers      ProjectFollow[]
  communityThreads CommunityThread[]
  bounties         FounderBounty[]
  helpfulMarks     HelpfulMark[]
  earlyScouts      EarlyScoutRecord[]
  agents           FounderAgent[]
  buildQueueItems  BuildQueueItem[]
  founderEvents    FounderEvent[]
  scoutMarkets     ScoutMarket[]

  @@index([slug])
  @@index([lifecycleStage])
  @@index([bubbleScore])
  @@index([chainId])
  @@index([categoryId])
  @@index([featured])
  @@index([approved])
  @@index([source])
  @@index([trackingActive])
}

model ProjectMetrics {
  id           String   @id @default(cuid())
  projectId    String   @unique
  priceUsd     Decimal? @db.Decimal(24, 12)
  marketCap    Decimal? @db.Decimal(24, 2)
  fdv          Decimal? @db.Decimal(24, 2)
  volume24h    Decimal? @db.Decimal(24, 2)
  liquidity    Decimal? @db.Decimal(24, 2)
  holders      Int?
  priceChange24h Decimal? @db.Decimal(10, 4)
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectSocials {
  id          String  @id @default(cuid())
  projectId   String  @unique
  twitterUrl  String?
  discordUrl  String?
  telegramUrl String?
  githubUrl   String?
  mediumUrl   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectDocument {
  id        String   @id @default(cuid())
  projectId String
  title     String
  url       String
  type      String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AuditReport {
  id         String   @id @default(cuid())
  projectId  String
  auditor    String
  reportUrl  String
  auditedAt  DateTime?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model FeaturedProject {
  id        String   @id @default(cuid())
  projectId String   @unique
  order     Int      @default(0)
  note      String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Watchlist ─────────────────────────────────────────────────────────────────

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// ─── Paper Trading ─────────────────────────────────────────────────────────────

model PaperPortfolio {
  id           String   @id @default(cuid())
  userId       String   @unique
  cashBalance  Decimal  @default(10000) @db.Decimal(16, 2)
  totalValue   Decimal  @default(10000) @db.Decimal(16, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions PaperPosition[]
}

model PaperPosition {
  id           String   @id @default(cuid())
  portfolioId  String
  projectId    String
  quantity     Decimal  @db.Decimal(24, 12)
  avgBuyPrice  Decimal  @db.Decimal(24, 12)
  convictionThesis    String?  @db.Text
  convictionCatalyst  String?
  convictionTargetUsd Decimal? @db.Decimal(24, 12)
  convictionTimeHorizon String?
  convictionRecordedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolio PaperPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, projectId])
  @@index([portfolioId])
  @@index([projectId])
}

model PaperTrade {
  id        String         @id @default(cuid())
  userId    String
  projectId String
  side      PaperTradeSide
  quantity  Decimal        @db.Decimal(24, 12)
  priceUsd  Decimal        @db.Decimal(24, 12)
  totalUsd  Decimal        @db.Decimal(16, 2)
  createdAt DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedPost FeedPost?

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

// ─── Social Feed ───────────────────────────────────────────────────────────────

model FeedPost {
  id              String    @id @default(cuid())
  paperTradeId    String    @unique
  userId          String
  projectId       String
  initialComment  String?
  commentCount    Int       @default(0)
  highlightedUntil DateTime?
  lastCommentAt   DateTime?
  createdAt       DateTime  @default(now())

  paperTrade PaperTrade    @relation(fields: [paperTradeId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments   FeedComment[]

  @@index([commentCount])
  @@index([highlightedUntil])
  @@index([createdAt])
  @@index([lastCommentAt])
}

model FeedComment {
  id         String   @id @default(cuid())
  feedPostId String
  userId     String
  body       String
  createdAt  DateTime @default(now())

  feedPost FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedPostId])
  @@index([createdAt])
}

// ─── Leaderboard ───────────────────────────────────────────────────────────────

model LeaderboardEntry {
  id        String            @id @default(cuid())
  userId    String
  period    LeaderboardPeriod
  roi       Decimal           @db.Decimal(10, 4)
  pnl       Decimal           @db.Decimal(16, 2)
  rank      Int
  computedAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period, rank])
}

// ─── Listing Applications ──────────────────────────────────────────────────────

model ListingApplication {
  id              String        @id @default(cuid())
  userId          String?
  projectName     String
  ticker          String
  websiteUrl      String?
  docsUrl         String?
  whitepaperUrl   String?
  contractAddress String?
  chainSlug       ChainSlug?
  dexscreenerUrl  String?
  logoUrl         String?
  telegramUrl     String?
  founderName     String?
  founderLinkedIn String?
  founderTwitter  String?
  founderGithub       String?
  founderVideoUrl     String?
  founderInterviewUrl String?
  companyDetails      String?       @db.Text
  auditUrl            String?
  summary             String?       @db.Text
  marketPreview       Json?
  verificationScore   Int           @default(0)
  verificationCriteria Json?
  whyList             String?       @db.Text
  whyDoxxed           String?       @db.Text
  votingOpensAt       DateTime?
  votingClosesAt      DateTime?
  requiredVoters      Int           @default(5)
  minYesPercent       Int           @default(65)
  status              ListingStatus @default(COMMUNITY_VOTING)
  reviewNotes     String?       @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes ListingVote[]

  @@index([status])
  @@index([createdAt])
  @@index([votingClosesAt])
}

model ListingVote {
  id            String           @id @default(cuid())
  applicationId String
  userId        String
  vote          ListingVoteValue
  whyList       String?          @db.Text
  whyDoxxed     String?          @db.Text
  comment       String?          @db.Text
  createdAt     DateTime         @default(now())

  application ListingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([applicationId, userId])
  @@index([applicationId])
  @@index([userId])
}

// ─── Reputation, notifications & founder updates ───────────────────────────────

enum NotificationType {
  FOUNDER_UPDATES
  LISTING_APPROVED
  LISTING_VOTING
  TRENDING_BUYS
  TRADER_WIN
  TRADER_LOSS
  POINTS_EARNED
  BUILD_QUEUE
  AGENT_RESULT
  FOUNDER_EVENT
  SYSTEM
}

enum XSocialPostKind {
  FOUNDER_REPOST
  TRENDING_BUYS
  TRADER_WIN
  TRADER_LOSS
}

model XSocialPostLog {
  id         String           @id @default(cuid())
  kind       XSocialPostKind
  dedupeKey  String           @unique
  tweetId    String?
  tweetUrl   String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([kind, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String           @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model FounderUpdate {
  id          String    @id @default(cuid())
  projectId   String?
  founderId   String?
  sourceUrl   String
  headline    String
  summary     String?   @db.Text
  pinned      Boolean   @default(true)
  pinnedUntil DateTime?
  externalId  String?   @unique
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  founder Founder? @relation(fields: [founderId], references: [id], onDelete: SetNull)

  @@index([pinned, pinnedUntil])
  @@index([publishedAt])
}

model FounderVideo {
  id          String           @id @default(cuid())
  founderId   String
  projectId   String?
  type        FounderVideoType @default(INTRODUCTION)
  title       String
  url         String
  durationMin Int?
  publishedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())

  founder Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([founderId])
  @@index([publishedAt])
}

model FounderBuildPost {
  id          String   @id @default(cuid())
  founderId   String
  projectId   String?
  dayNumber   Int?
  headline    String
  body        String   @db.Text
  githubUrl   String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  founder Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([founderId])
  @@index([publishedAt])
}

model ProjectRoadmapItem {
  id        String        @id @default(cuid())
  projectId String
  title     String
  status    RoadmapStatus @default(PLANNED)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildQueueItems BuildQueueItem[]

  @@index([projectId])
}

model BuildQueueItem {
  id               String             @id @default(cuid())
  founderId        String
  projectId        String?
  parentId         String?
  kind             BuildQueueItemKind
  status           BuildQueueStatus   @default(CAPTURED)
  source           BuildQueueSource   @default(MANUAL)
  title            String
  description      String?            @db.Text
  spec             String?            @db.Text
  githubIssueTitle String?
  githubIssueUrl   String?
  cursorPrompt     String?            @db.Text
  roadmapItemId    String?
  agentRunId       String?
  sortOrder        Int                @default(0)
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  founder     Founder             @relation(fields: [founderId], references: [id], onDelete: Cascade)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent      BuildQueueItem?     @relation("QueueTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    BuildQueueItem[]    @relation("QueueTree")
  roadmapItem ProjectRoadmapItem? @relation(fields: [roadmapItemId], references: [id], onDelete: SetNull)
  agentRun    AgentRun?           @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([founderId, status])
  @@index([founderId, kind])
  @@index([projectId])
  @@index([createdAt(sort: Desc)])
}

model SimulatedRaise {
  id                    String               @id @default(cuid())
  projectId             String
  goalUsd               Decimal              @db.Decimal(16, 2)
  tokenAllocation       String?
  communityTokenPercent Int                  @default(10)
  maxParticipantSlots   Int?
  totalBurnedUsd        Decimal              @default(0) @db.Decimal(16, 2)
  slotsLocked           Boolean              @default(false)
  durationDays          Int                  @default(14)
  plannedLaunchDate     DateTime?
  status                SimulatedRaiseStatus @default(DRAFT)
  startsAt              DateTime?
  endsAt                DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocations RaiseAllocation[]

  @@index([projectId])
