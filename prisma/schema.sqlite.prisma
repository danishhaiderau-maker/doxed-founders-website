generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./selfhost.db"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ChainSlug {
  ETHEREUM
  SOLANA
  POLYGON
  ARBITRUM
  OPTIMISM
  BASE
  AVALANCHE
  BNB_CHAIN
}

enum ListingStatus {
  COMMUNITY_VOTING
  PENDING
  APPROVED
  REJECTED
}

enum ListingVoteValue {
  YES
  NO
}

enum VerificationType {
  IDENTITY
  LINKEDIN
  GITHUB
  KYC
  AUDIT
  TEAM_DOXXED
}

enum AnalyticsEventType {
  PAGE_VIEW
  SEARCH
  WATCHLIST_ADD
  WATCHLIST_REMOVE
  PAPER_TRADE_BUY
  PAPER_TRADE_SELL
  PROJECT_CLICK
}

enum PaperTradeSide {
  BUY
  SELL
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum ProjectSource {
  CURATED
  DYNAMIC
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  role          UserRole  @default(USER)
  emailVerified DateTime?
  banned        Boolean   @default(false)
  bannedReason  String?
  reputationPoints Int    @default(0)
  contributorLevel Int    @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  watchlists           Watchlist[]
  paperPortfolio       PaperPortfolio?
  paperTrades          PaperTrade[]
  feedPosts            FeedPost[]
  feedComments         FeedComment[]
  listingApplications  ListingApplication[]
  listingVotes         ListingVote[]
  analyticsEvents      AnalyticsEvent[]
  searchLogs           SearchLog[]
  adminActions         AdminAction[]        @relation("AdminActions")
  leaderboardEntries   LeaderboardEntry[]
  oauthAccounts        OAuthAccount[]
  notifications        Notification[]

  @@index([email])
  @@index([role])
}

model OAuthAccount {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// ─── Chains & Categories ─────────────────────────────────────────────────────

model Chain {
  id        String    @id @default(cuid())
  slug      ChainSlug @unique
  name      String
  iconUrl   String?
  createdAt DateTime  @default(now())

  projects Project[]
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())

  projects Project[]
}

// ─── Founders ────────────────────────────────────────────────────────────────

model Founder {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  bio         String? 
  photoUrl    String?
  linkedInUrl String?
  twitterUrl  String?
  githubUrl   String?
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects      Project[]
  verifications FounderVerification[]
  founderUpdates FounderUpdate[]
}

model FounderVerification {
  id         String           @id @default(cuid())
  founderId  String
  type       VerificationType
  verified   Boolean          @default(false)
  verifiedAt DateTime?
  notes      String?
  createdAt  DateTime         @default(now())

  founder Founder @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@unique([founderId, type])
  @@index([founderId])
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  ticker          String
  description     String?      
  summary         String?      
  logoUrl         String?
  websiteUrl      String?
  docsUrl         String?
  whitepaperUrl   String?
  contractAddress String?
  dexscreenerUrl  String?
  chainId         String
  categoryId      String?
  founderId       String?
  source          ProjectSource @default(CURATED)
  trackingActive  Boolean       @default(true)
  lastTradeAt     DateTime?
  featured        Boolean       @default(false)
  approved        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  chain    Chain     @relation(fields: [chainId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  founder  Founder?  @relation(fields: [founderId], references: [id])

  metrics       ProjectMetrics?
  socials       ProjectSocials?
  documents     ProjectDocument[]
  watchlists    Watchlist[]
  paperTrades    PaperTrade[]
  paperPositions PaperPosition[]
  feedPosts      FeedPost[]
  featuredEntry  FeaturedProject?
  auditReports  AuditReport[]
  trendingScore TrendingScore?
  analyticsEvents AnalyticsEvent[]
  founderUpdates FounderUpdate[]

  @@index([slug])
  @@index([chainId])
  @@index([categoryId])
  @@index([featured])
  @@index([approved])
  @@index([source])
  @@index([trackingActive])
}

model ProjectMetrics {
  id           String   @id @default(cuid())
  projectId    String   @unique
  priceUsd     Decimal?
  marketCap    Decimal?
  fdv          Decimal?
  volume24h    Decimal?
  liquidity    Decimal?
  holders      Int?
  priceChange24h Decimal?
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectSocials {
  id          String  @id @default(cuid())
  projectId   String  @unique
  twitterUrl  String?
  discordUrl  String?
  telegramUrl String?
  githubUrl   String?
  mediumUrl   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectDocument {
  id        String   @id @default(cuid())
  projectId String
  title     String
  url       String
  type      String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AuditReport {
  id         String   @id @default(cuid())
  projectId  String
  auditor    String
  reportUrl  String
  auditedAt  DateTime?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model FeaturedProject {
  id        String   @id @default(cuid())
  projectId String   @unique
  order     Int      @default(0)
  note      String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Watchlist ─────────────────────────────────────────────────────────────────

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// ─── Paper Trading ─────────────────────────────────────────────────────────────

model PaperPortfolio {
  id           String   @id @default(cuid())
  userId       String   @unique
  cashBalance  Decimal  @default(10000)
  totalValue   Decimal  @default(10000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions PaperPosition[]
}

model PaperPosition {
  id           String  @id @default(cuid())
  portfolioId  String
  projectId    String
  quantity     Decimal
  avgBuyPrice  Decimal
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolio PaperPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, projectId])
  @@index([portfolioId])
  @@index([projectId])
}

model PaperTrade {
  id        String         @id @default(cuid())
  userId    String
  projectId String
  side      PaperTradeSide
  quantity  Decimal       
  priceUsd  Decimal       
  totalUsd  Decimal       
  createdAt DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedPost FeedPost?

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

// ─── Social Feed ───────────────────────────────────────────────────────────────

model FeedPost {
  id              String    @id @default(cuid())
  paperTradeId    String    @unique
  userId          String
  projectId       String
  initialComment  String?
  commentCount    Int       @default(0)
  highlightedUntil DateTime?
  lastCommentAt   DateTime?
  createdAt       DateTime  @default(now())

  paperTrade PaperTrade    @relation(fields: [paperTradeId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments   FeedComment[]

  @@index([commentCount])
  @@index([highlightedUntil])
  @@index([createdAt])
  @@index([lastCommentAt])
}

model FeedComment {
  id         String   @id @default(cuid())
  feedPostId String
  userId     String
  body       String
  createdAt  DateTime @default(now())

  feedPost FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedPostId])
  @@index([createdAt])
}

// ─── Leaderboard ───────────────────────────────────────────────────────────────

model LeaderboardEntry {
  id        String            @id @default(cuid())
  userId    String
  period    LeaderboardPeriod
  roi       Decimal          
  pnl       Decimal          
  rank      Int
  computedAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period, rank])
}

// ─── Listing Applications ──────────────────────────────────────────────────────

model ListingApplication {
  id              String        @id @default(cuid())
  userId          String?
  projectName     String
  ticker          String
  websiteUrl      String?
  docsUrl         String?
  whitepaperUrl   String?
  contractAddress String?
  chainSlug       ChainSlug?
  dexscreenerUrl  String?
  logoUrl         String?
  telegramUrl     String?
  founderName     String?
  founderLinkedIn String?
  founderTwitter  String?
  founderGithub       String?
  founderVideoUrl     String?
  founderInterviewUrl String?
  companyDetails      String?      
  auditUrl            String?
  summary             String?      
  marketPreview       Json?
  verificationScore   Int           @default(0)
  verificationCriteria Json?
  whyList             String?      
  whyDoxxed           String?      
  votingOpensAt       DateTime?
  votingClosesAt      DateTime?
  requiredVoters      Int           @default(5)
  minYesPercent       Int           @default(65)
  status              ListingStatus @default(COMMUNITY_VOTING)
  reviewNotes     String?      
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes ListingVote[]

  @@index([status])
  @@index([createdAt])
  @@index([votingClosesAt])
}

model ListingVote {
  id            String           @id @default(cuid())
  applicationId String
  userId        String
  vote          ListingVoteValue
  whyList       String?          
  whyDoxxed     String?          
  comment       String?          
  createdAt     DateTime         @default(now())

  application ListingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([applicationId, userId])
  @@index([applicationId])
  @@index([userId])
}

// ─── Reputation, notifications & founder updates ───────────────────────────────

enum NotificationType {
  FOUNDER_UPDATES
  LISTING_APPROVED
  LISTING_VOTING
  TRENDING_BUYS
  TRADER_WIN
  POINTS_EARNED
  SYSTEM
}

enum XSocialPostKind {
  FOUNDER_REPOST
  TRENDING_BUYS
  TRADER_WIN
}

model XSocialPostLog {
  id         String           @id @default(cuid())
  kind       XSocialPostKind
  dedupeKey  String           @unique
  tweetId    String?
  tweetUrl   String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([kind, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model FounderUpdate {
  id          String    @id @default(cuid())
  projectId   String?
  founderId   String?
  sourceUrl   String
  headline    String
  summary     String?
  pinned      Boolean   @default(true)
  pinnedUntil DateTime?
  externalId  String?   @unique
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  founder Founder? @relation(fields: [founderId], references: [id], onDelete: SetNull)

  @@index([pinned, pinnedUntil])
  @@index([publishedAt])
}

// ─── Admin ─────────────────────────────────────────────────────────────────────

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}

// ─── Analytics & Trending ──────────────────────────────────────────────────────

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  userId    String?
  projectId String?
  metadata  Json?
  createdAt DateTime           @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([projectId])
  @@index([createdAt])
}

model SearchLog {
  id        String   @id @default(cuid())
  userId    String?
  query     String
  results   Int      @default(0)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
}

model TrendingScore {
  id        String   @id @default(cuid())
  projectId String   @unique
  score     Decimal 
  computedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([score(sort: Desc)])
}

// ─── API Cache ─────────────────────────────────────────────────────────────────

model ApiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
