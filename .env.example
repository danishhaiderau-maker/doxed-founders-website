# Database
# Neon (no Docker):  npm run setup:neon
# Docker local:      npm run setup
# SQLite local dev:  npm run setup:local
DATABASE_URL="postgresql://dcf:dcf_secret@localhost:5432/doxedcryptofounder?schema=public"

# API
API_PORT=4000
API_URL="http://localhost:4000"
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Market data (optional overrides; no API keys required for free tier)
DEXSCREENER_API_URL="https://api.dexscreener.com"
GECKOTERMINAL_API_URL="https://api.geckoterminal.com/api/v2"
# Webhook (local): stripe listen --forward-to localhost:4000/api/paper-trading/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
