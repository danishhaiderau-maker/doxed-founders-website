# Whitelist: ship ONLY source the bot needs to run.
# All runtime/research data regenerates on the persistent volume
# (fly-entrypoint.sh recreates research*/ dirs as volume symlinks on first boot).
# This keeps the build context tiny (~MB, not 440MB).

# 1. Exclude everything by default.
*

# 2. Re-include Python source at the repo root (bot, analyzer, pathways, executors).
!*.py

# 3. Re-include the research_genome package (imported by the bot at runtime).
!research_genome/
!research_genome/**

# Shared fail-closed cohort contract imported by the canonical analyzer during
# bot startup. Keep the rest of the large research tree outside the Fly image.
!research/
research/*
!research/analysis_eligibility.py
!research/dual_execution_truth.py
!research/platform_relay_evidence.py
!research/source_market_evidence.py
!research/immutable_archive.py
!research/counterfactual_normalization.py
!research/epoch_quarantine.py
!research/shadow_outcome_reconstruction.py

# 4. Re-include deploy + Python dependency manifests.
!requirements.txt
!fly-entrypoint.sh

# 5. Re-include version-controlled manifests + text configuration only.
#    (Small — some are source config the bot reads at startup, e.g. pathway_lane_specs.json,
#     roster_policy.json. Runtime state .json files here are tiny and harmless to ship.)
!manifest.json
!genome_cluster_library.json
!*.txt
!*.toml
!*.yaml
!*.yml

# Explicitly keep excluded (apart from the runtime research modules above): research/, research_accumulator/,
# research_archive/, logs/, .git/, node_modules/, .next/, dist/, .turbo/, .cursor/,
# and any home-stack markers / local secrets (.home-*, *-home.env, .openai_*, .anthropic_*).
