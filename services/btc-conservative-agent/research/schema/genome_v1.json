{
  "schema_version": "1.0.0",
  "description": "Trading Genome v1 — locked field definitions for bot recorders and analyzer loaders",
  "id_chain": [
    "environment_id",
    "market_genome_id",
    "decision_id",
    "execution_id",
    "trade_id",
    "outcome_id"
  ],
  "events": {
    "AI_SCAN_COMPLETE": { "event_version": 1, "layer": "market" },
    "AI_APPROVED": { "event_version": 1, "layer": "decision" },
    "AI_REJECTED": { "event_version": 1, "layer": "decision" },
    "LIMIT_CREATED": { "event_version": 1, "layer": "execution" },
    "LIMIT_CHASED": { "event_version": 1, "layer": "execution" },
    "ORDER_FILLED": { "event_version": 1, "layer": "execution" },
    "ORDER_CANCELLED": { "event_version": 1, "layer": "execution" },
    "ORDER_EXPIRED": { "event_version": 1, "layer": "execution" },
    "POSITION_OPENED": { "event_version": 1, "layer": "lifecycle" },
    "POSITION_UPDATED": { "event_version": 1, "layer": "lifecycle" },
    "POSITION_CLOSED": { "event_version": 1, "layer": "lifecycle" },
    "MFE_UPDATED": { "event_version": 1, "layer": "lifecycle" },
    "MAE_UPDATED": { "event_version": 1, "layer": "lifecycle" },
    "LADDER_STEP_ARMED": { "event_version": 1, "layer": "lifecycle" },
    "LADDER_STEP_HIT": { "event_version": 1, "layer": "lifecycle" },
    "STOP_UPDATED": { "event_version": 1, "layer": "lifecycle" },
    "THESIS_CHANGED": { "event_version": 1, "layer": "lifecycle" },
    "EXIT_TRIGGERED": { "event_version": 1, "layer": "lifecycle" }
  },
  "fields": [
    { "name": "environment_id", "type": "string", "units": "uuid", "layer": "environment", "version": 1, "description": "Immutable environment context ID" },
    { "name": "market_genome_id", "type": "string", "units": "uuid", "layer": "market", "version": 1, "description": "Market state snapshot at AI scan" },
    { "name": "decision_id", "type": "string", "units": "uuid", "layer": "decision", "version": 1, "description": "AI decision record (approve or reject)" },
    { "name": "execution_id", "type": "string", "units": "uuid", "layer": "execution", "version": 1, "description": "Order lifecycle execution record" },
    { "name": "trade_id", "type": "string", "units": "uuid", "layer": "trade", "version": 1, "description": "Closed trade summary ID" },
    { "name": "outcome_id", "type": "string", "units": "uuid", "layer": "outcome", "version": 1, "description": "Analyzer-generated outcome classification" },
    { "name": "ts", "type": "string", "units": "iso8601", "layer": "all", "version": 1, "description": "UTC timestamp (supplement to IDs, not join key)" },
    { "name": "event_name", "type": "string", "units": "enum", "layer": "event", "version": 1, "description": "Research event bus event type" },
    { "name": "event_version", "type": "integer", "units": "count", "layer": "event", "version": 1, "description": "Independent event schema version" },
    { "name": "is_weekend", "type": "boolean", "units": "flag", "layer": "environment", "version": 1, "description": "Saturday or Sunday in Melbourne session calendar" },
    { "name": "day_of_week", "type": "integer", "units": "0-6", "layer": "environment", "version": 1, "description": "Monday=0 … Sunday=6" },
    { "name": "hour_utc", "type": "integer", "units": "0-23", "layer": "environment", "version": 1, "description": "Hour of scan in UTC" },
    { "name": "trading_session", "type": "string", "units": "enum", "layer": "environment", "version": 1, "description": "ASIA | EUROPE | US | OVERLAP" },
    { "name": "funding_window", "type": "boolean", "units": "flag", "layer": "environment", "version": 1, "description": "Within ±30m of funding settlement" },
    { "name": "month_end", "type": "boolean", "units": "flag", "layer": "environment", "version": 1, "description": "Last 3 calendar days of month" },
    { "name": "quarter_end", "type": "boolean", "units": "flag", "layer": "environment", "version": 1, "description": "Last 5 calendar days of quarter" },
    { "name": "ema_fast", "type": "number", "units": "usd", "layer": "market", "version": 1, "description": "Fast EMA value at scan" },
    { "name": "ema_slow", "type": "number", "units": "usd", "layer": "market", "version": 1, "description": "Slow EMA value at scan" },
    { "name": "ema_slope", "type": "number", "units": "pct", "layer": "market", "version": 1, "description": "EMA spread slope" },
    { "name": "adx", "type": "number", "units": "index", "layer": "market", "version": 1, "description": "ADX at scan" },
    { "name": "atr", "type": "number", "units": "usd", "layer": "market", "version": 1, "description": "ATR at scan" },
    { "name": "volatility_percentile", "type": "number", "units": "0-100", "layer": "market", "version": 1, "description": "Rolling volatility percentile" },
    { "name": "volume_percentile", "type": "number", "units": "0-100", "layer": "market", "version": 1, "description": "Rolling volume percentile" },
    { "name": "bull_score", "type": "integer", "units": "count", "layer": "market", "version": 1, "description": "AI bull score" },
    { "name": "bear_score", "type": "integer", "units": "count", "layer": "market", "version": 1, "description": "AI bear score" },
    { "name": "spread", "type": "integer", "units": "count", "layer": "market", "version": 1, "description": "Directional spread at scan" },
    { "name": "funding_rate", "type": "number", "units": "pct", "layer": "market", "version": 1, "description": "Current funding rate" },
    { "name": "vwap_distance", "type": "number", "units": "pct", "layer": "market", "version": 1, "description": "Price distance from VWAP" },
    { "name": "delta", "type": "number", "units": "btc", "layer": "market", "version": 1, "description": "Order book delta proxy" },
    { "name": "momentum", "type": "number", "units": "pct", "layer": "market", "version": 1, "description": "Short-horizon momentum" },
    { "name": "structure", "type": "number", "units": "index", "layer": "market", "version": 1, "description": "Structure score" },
    { "name": "support_distance", "type": "number", "units": "pct", "layer": "market", "version": 1, "description": "Distance to nearest support" },
    { "name": "resistance_distance", "type": "number", "units": "pct", "layer": "market", "version": 1, "description": "Distance to nearest resistance" },
    { "name": "decision", "type": "string", "units": "enum", "layer": "decision", "version": 1, "description": "APPROVE | REJECT" },
    { "name": "ai_confidence", "type": "integer", "units": "0-100", "layer": "decision", "version": 1, "description": "AI win probability" },
    { "name": "block_reason", "type": "string", "units": "text", "layer": "decision", "version": 1, "description": "Gate or AI rejection reason" },
    { "name": "direction", "type": "string", "units": "enum", "layer": "decision", "version": 1, "description": "LONG | SHORT" },
    { "name": "research_lane", "type": "string", "units": "text", "layer": "decision", "version": 1, "description": "Pathway lane at decision time" },
    { "name": "limit_price", "type": "number", "units": "usd", "layer": "execution", "version": 1, "description": "Limit order price" },
    { "name": "fill_price", "type": "number", "units": "usd", "layer": "execution", "version": 1, "description": "Actual fill price" },
    { "name": "slippage_bps", "type": "number", "units": "bps", "layer": "execution", "version": 1, "description": "Slippage vs limit" },
    { "name": "latency_ms", "type": "number", "units": "ms", "layer": "execution", "version": 1, "description": "Signal-to-fill latency" },
    { "name": "mfe_pct", "type": "number", "units": "pct", "layer": "lifecycle", "version": 1, "description": "Maximum favorable excursion" },
    { "name": "mae_pct", "type": "number", "units": "pct", "layer": "lifecycle", "version": 1, "description": "Maximum adverse excursion" },
    { "name": "ladder_stage", "type": "integer", "units": "count", "layer": "lifecycle", "version": 1, "description": "Current Scenario C ladder stage" },
    { "name": "stop_price", "type": "number", "units": "usd", "layer": "lifecycle", "version": 1, "description": "Active stop price" },
    { "name": "entry_price", "type": "number", "units": "usd", "layer": "trade", "version": 1, "description": "Trade entry price" },
    { "name": "exit_price", "type": "number", "units": "usd", "layer": "trade", "version": 1, "description": "Trade exit price" },
    { "name": "duration_sec", "type": "number", "units": "seconds", "layer": "trade", "version": 1, "description": "Hold duration" },
    { "name": "pnl_usd", "type": "number", "units": "usd", "layer": "trade", "version": 1, "description": "Net PnL" },
    { "name": "capture_pct", "type": "number", "units": "pct", "layer": "trade", "version": 1, "description": "MFE capture percentage" },
    { "name": "exit_reason", "type": "string", "units": "text", "layer": "trade", "version": 1, "description": "Exit trigger reason" },
    { "name": "outcome_type", "type": "string", "units": "enum", "layer": "outcome", "version": 1, "description": "TYPE_A | TYPE_B | UNKNOWN" },
    { "name": "leakage_usd", "type": "number", "units": "usd", "layer": "outcome", "version": 1, "description": "Exit leakage estimate" },
    { "name": "dna_quality", "type": "number", "units": "0-100", "layer": "analyzer", "version": 1, "description": "DNA Quality composite score" },
    { "name": "confidence_interval_95_low", "type": "number", "units": "ev", "layer": "analyzer", "version": 1, "description": "95% CI lower bound on EV" },
    { "name": "confidence_interval_95_high", "type": "number", "units": "ev", "layer": "analyzer", "version": 1, "description": "95% CI upper bound on EV" },
    { "name": "research_confidence", "type": "string", "units": "enum", "layer": "analyzer", "version": 1, "description": "LOW | MODERATE | HIGH" },
    { "name": "cluster_id", "type": "string", "units": "text", "layer": "analyzer", "version": 1, "description": "Assigned cluster or UNKNOWN" },
    { "name": "similarity_pct", "type": "number", "units": "0-100", "layer": "analyzer", "version": 1, "description": "Similarity to nearest cluster" }
  ]
}
