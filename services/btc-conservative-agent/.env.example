# Active exchange (set by platform when admin saves showcase keys)
EXCHANGE_PROVIDER=bybit

# Bybit (showcase bot v0.5.0 executes here today)
BYBIT_API_KEY=
BYBIT_SECRET=
# BYBIT_TESTNET=1

# Binance
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_TESTNET=1

# OKX (requires passphrase)
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# OKX_TESTNET=1

# Bitfinex
# BITFINEX_API_KEY=
# BITFINEX_API_SECRET=

# Hyperliquid (agent wallet — never use main wallet key)
# HYPERLIQUID_WALLET_ADDRESS=
# HYPERLIQUID_PRIVATE_KEY=
# HYPERLIQUID_MAIN_WALLET=

# DeepSeek AI reviewer (optional — bot runs rule-based fallback without it)
DEEPSEEK_API_KEY=

# Flask dashboard (Agent Hub reads GET /api/state from this port)
PORT=5000
