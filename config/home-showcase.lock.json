{
  "schema": "desktop_fly_mirror_v1",
  "frozen": true,
  "authoritative": false,
  "purpose": "Desktop dashboard proxy and analyzer mirror for the canonical Fly bot",
  "mode": "fly-mirror",
  "sourceUrl": "https://doxed-btc-bot.fly.dev",
  "botPort": 7002,
  "botRole": "fly-dashboard-proxy",
  "analyzerPort": 9001,
  "analyzerRole": "fly-data-mirror-analysis",
  "dataDirDefault": "%LOCALAPPDATA%/DoxxedCrypto/fly-data-mirror",
  "dataDirEnv": "DOXXED_FLY_MIRROR_DIR",
  "disableLocalStrategy": true,
  "disableRelayWebhook": true,
  "disableTunnel": true
}
