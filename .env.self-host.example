# ─── Self-host from your laptop (secure defaults) ───
# Copy to .env.self-host — NEVER commit this file.
# Run: npm run setup:self-host

# Database — SQLite on disk (no Docker/cloud required for experiments)
DATABASE_URL="file:./prisma/selfhost.db"
PRISMA_SCHEMA="prisma/schema.sqlite.prisma"
DEV_DB=sqlite

# Bind to localhost ONLY — public access via Cloudflare Tunnel, not open router ports
API_PORT=4000
API_BIND_HOST=127.0.0.1
WEB_BIND_HOST=127.0.0.1
WEB_PORT=3000

# Replace after setup:self-host generates secrets, or use your Cloudflare tunnel URLs
API_URL="https://api.YOUR-DOMAIN.com"
NEXT_PUBLIC_API_URL="https://api.YOUR-DOMAIN.com"
NEXTAUTH_URL="https://YOUR-DOMAIN.com"
CORS_ORIGINS="https://YOUR-DOMAIN.com"

JWT_SECRET="REPLACE-WITH-GENERATED-SECRET"
JWT_EXPIRES_IN="7d"
NEXTAUTH_SECRET="REPLACE-WITH-GENERATED-SECRET"

# Google OAuth — add redirect: https://YOUR-DOMAIN.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe test mode is fine for experiments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
