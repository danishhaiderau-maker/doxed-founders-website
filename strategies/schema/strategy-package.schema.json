{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doxxedcrypto.digital/schemas/strategy-package.schema.json",
  "title": "StrategyPackage",
  "description": "YAML strategy package tile spec (R47 / Strategist PLAN-EXT2 §8). paper_only must be true. No packages are activated by this schema alone — each tile still needs its own R22 + RK PASS. Numeric bars follow-up gates any strategies/*.yaml until implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "thesis",
    "series_stamp",
    "kind",
    "entry",
    "exit",
    "regime_filter",
    "sizing",
    "daily_loss_cap_usd",
    "costs",
    "data_requires",
    "evidence",
    "paper_only"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "description": "Allows hyphenated ids (e.g. ext2-lead-01) per Strategist §8"
    },
    "name": { "type": "string", "minLength": 1 },
    "thesis": { "type": "string", "minLength": 1 },
    "series_stamp": {
      "type": "string",
      "minLength": 1,
      "description": "R52/P5 series stamp — required; refuse pooled series across breaks"
    },
    "kind": { "type": "string", "enum": ["single", "regime_set"] },
    "members": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "regime_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "tiebreak"],
      "properties": {
        "priority": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "tiebreak": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "params"],
      "properties": {
        "signal": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "cooldown_min": {
          "type": "number",
          "minimum": 0,
          "description": "Optional per Strategist §8"
        }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composite", "thesis_cut", "hard_stop_pct", "tp", "max_hold_min"],
      "properties": {
        "composite": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "thesis_cut": { "type": ["string", "boolean", "object", "null"] },
        "hard_stop_pct": { "type": "number" },
        "tp": { "type": ["number", "string", "object", "null"] },
        "max_hold_min": { "type": "number", "minimum": 0 }
      }
    },
    "regime_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "params"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["margin_usd", "leverage"],
      "properties": {
        "margin_usd": { "type": "number", "minimum": 0.2, "maximum": 0.25 },
        "leverage": { "type": "number", "const": 100 }
      }
    },
    "daily_loss_cap_usd": { "type": "number", "exclusiveMinimum": 0 },
    "costs": { "type": "string", "const": "REALISTIC_V1" },
    "data_requires": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["book10", "trades", "funding", "liquidations", "premium", "cvd"]
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "window"],
      "properties": {
        "status": { "type": "string", "enum": ["LEAD", "OOS_PASS", "FWD_PASS"] },
        "window": { "type": "string", "minLength": 1 },
        "oos_22m": {
          "type": ["string", "object"],
          "description": "22m OOS label; OOS_PASS/FWD_PASS require HOLDS (loader-enforced)"
        },
        "oos_22m_summary": {
          "type": ["string", "object"],
          "description": "Legacy alias for oos_22m; HOLDS accepted"
        },
        "in_window": { "type": ["boolean", "string", "object", "null"] },
        "bh_fdr_pass": { "type": ["boolean", "string", "null"] },
        "bonferroni_pass": { "type": ["boolean", "string", "null"] },
        "reality_check_p": { "type": ["number", "string", "null"] },
        "deflated_sharpe": { "type": ["number", "string", "null"] },
        "pbo": { "type": ["number", "string", "null"] },
        "funding_sensitive": { "type": ["boolean", "string", "null"] },
        "leak_suspect": {
          "type": ["boolean", "null"],
          "description": "OOS_PASS/FWD_PASS require exactly false (loader-enforced)"
        },
        "combos_searched": { "type": "integer", "minimum": 0 },
        "fdr": { "type": ["number", "string", "object", "boolean", "null"] }
      }
    },
    "paper_only": { "type": "boolean", "const": true }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "regime_set" } } },
      "then": {
        "required": ["members", "regime_set"],
        "properties": {
          "members": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "single" } } },
      "then": {
        "properties": {
          "members": { "maxItems": 1 }
        }
      }
    }
  ]
}
