{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doxxedcrypto.digital/schemas/strategy-package.schema.json",
  "title": "StrategyPackage",
  "description": "YAML strategy package tile spec (R47 / Strategist PLAN-EXT2 §8 + Boss extras 2026-11-04). paper_only must be true. No packages are activated by this schema alone — each tile still needs its own R22 + RK PASS. Numeric bars follow-up gates any strategies/*.yaml until implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "thesis",
    "series_stamp",
    "kind",
    "entry",
    "exit",
    "regime_filter",
    "sizing",
    "daily_loss_cap_usd",
    "costs",
    "data_requires",
    "evidence",
    "paper_only"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "description": "Allows hyphenated ids (e.g. ext2-lead-01) per Strategist §8"
    },
    "name": { "type": "string", "minLength": 1 },
    "thesis": { "type": "string", "minLength": 1 },
    "series_stamp": {
      "type": "string",
      "minLength": 1,
      "description": "R52/P5 series stamp — required; refuse pooled series across breaks"
    },
    "kind": { "type": "string", "enum": ["single", "regime_set"] },
    "members": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "regime_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "tiebreak"],
      "properties": {
        "priority": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "tiebreak": { "type": "string", "minLength": 1 }
      }
    },
    "holdout_spent": {
      "type": "boolean",
      "description": "Boss/Strategist optional: whether the holdout window was spent"
    },
    "holdout_spent_note": {
      "type": "string",
      "description": "Optional free-text note accompanying holdout_spent"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "params"],
      "properties": {
        "signal": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "cooldown_min": {
          "type": "number",
          "minimum": 0,
          "description": "Optional per Strategist §8"
        }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composite", "thesis_cut", "tp"],
      "properties": {
        "composite": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "thesis_cut": { "type": ["string", "boolean", "object", "null"] },
        "hard_stop_pct": {
          "type": "number",
          "description": "Optional stop in percent points (0.31 → 31 bp). Absent only when trail_pct or max_hold_min is set."
        },
        "stop_bp": {
          "type": "number",
          "minimum": 0,
          "description": "Optional explicit stop in basis points; used with sizing.max_stop_bp"
        },
        "trail_pct": {
          "type": "number",
          "minimum": 0,
          "description": "Optional trail; allows hard_stop_pct to be absent"
        },
        "tp": { "type": ["number", "string", "object", "null"] },
        "max_hold_min": { "type": "number", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["hard_stop_pct"] },
        { "required": ["stop_bp"] },
        { "required": ["trail_pct"] },
        { "required": ["max_hold_min"] }
      ]
    },
    "regime_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "params"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["margin_usd", "leverage"],
      "properties": {
        "margin_usd": { "type": "number", "minimum": 0.2, "maximum": 0.25 },
        "leverage": { "type": "number", "const": 100 },
        "max_stop_bp": {
          "type": "number",
          "minimum": 0,
          "description": "Optional cap; loader enforces stop_bp <= max_stop_bp"
        }
      }
    },
    "daily_loss_cap_usd": { "type": "number", "exclusiveMinimum": 0 },
    "costs": {
      "description": "REALISTIC_V1 string, or object with optional note (Boss/Strategist)",
      "oneOf": [
        { "type": "string", "const": "REALISTIC_V1" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": { "type": "string", "const": "REALISTIC_V1" },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "data_requires": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "book10",
          "trades",
          "funding",
          "liquidations",
          "premium",
          "cvd",
          "spot1s",
          "perp1s",
          "metrics",
          "depth",
          "basis1s",
          "bfx1s",
          "dvol"
        ]
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "window"],
      "properties": {
        "status": { "type": "string", "enum": ["LEAD", "OOS_PASS", "FWD_PASS"] },
        "window": { "type": "string", "minLength": 1 },
        "oos_22m": {
          "type": ["string", "object", "null"],
          "description": "22m OOS label; may be null or NOT_RUN; OOS_PASS/FWD_PASS require HOLDS"
        },
        "oos_22m_summary": {
          "type": ["string", "object", "null"],
          "description": "Legacy alias for oos_22m; HOLDS accepted"
        },
        "in_window": { "type": ["boolean", "string", "object", "null"] },
        "bh_fdr_pass": { "type": ["boolean", "string", "null"] },
        "bonferroni_pass": { "type": ["boolean", "string", "null"] },
        "reality_check_p": { "type": ["number", "string", "null"] },
        "deflated_sharpe": { "type": ["number", "string", "null"] },
        "pbo": { "type": ["number", "string", "null"] },
        "funding_sensitive": { "type": ["boolean", "string", "null"] },
        "leak_suspect": {
          "type": ["boolean", "null"],
          "description": "OOS_PASS/FWD_PASS require exactly false (loader-enforced)"
        },
        "combos_searched": { "type": "integer", "minimum": 0 },
        "fdr": { "type": ["number", "string", "object", "boolean", "null"] }
      }
    },
    "paper_only": { "type": "boolean", "const": true }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "regime_set" } } },
      "then": {
        "required": ["members", "regime_set"],
        "properties": {
          "members": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "single" } } },
      "then": {
        "properties": {
          "members": { "maxItems": 1 }
        }
      }
    }
  ]
}
