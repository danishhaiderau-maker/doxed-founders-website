# Copy to .env.x.secrets (gitignored) — NEVER commit real values.
# Generate Access Token + Secret in X Developer Portal → Keys → must be @Bitbro4crypto account.

# OAuth 2.0 (user login on website) — often same as API Key/Secret in X portal
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# OAuth 1.0a app keys
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Read founder tweets (Bearer — decode URL encoding if pasted from portal)
TWITTER_BEARER_TOKEN=

# Post as @Bitbro4crypto (REQUIRED for reposts — generate in X portal)
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

X_BRAND_HANDLE=Bitbro4crypto
PUBLIC_SITE_URL=https://doxxedcrypto.digital
API_URL=https://doxed-founders-website-production.up.railway.app

# For automated daily cron JWT (or leave blank — script logs in admin below)
ADMIN_SYNC_JWT=
ADMIN_EMAIL=admin@doxedcryptofounder.local
ADMIN_PASSWORD=

# Railway API token (Account Settings -> Tokens) — enables npm run finish:x-production
RAILWAY_TOKEN=
