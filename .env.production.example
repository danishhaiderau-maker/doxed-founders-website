# ─── Production template (Neon + Railway API + Vercel Web) ───

# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
PRISMA_SCHEMA="prisma/schema.prisma"
# First deploy only (no migrations yet): PRISMA_DB_PUSH=true

# API (Railway / Render)
PORT=4000
API_PORT=4000
API_URL="https://your-api.up.railway.app"
JWT_SECRET="long-random-production-secret"
JWT_EXPIRES_IN="7d"

# Web (Vercel)
NEXT_PUBLIC_API_URL="https://your-api.up.railway.app"
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="long-random-production-secret"
CORS_ORIGINS="https://your-domain.vercel.app"

# Google OAuth (production redirect in Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (live or test keys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
