# ─── Production template (Neon + Railway API + Vercel Web) ───

# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
PRISMA_SCHEMA="prisma/schema.prisma"
# First deploy only (no migrations yet): PRISMA_DB_PUSH=true

# API (Railway / Render)
PORT=4000
API_PORT=4000
API_URL="https://your-api.up.railway.app"
JWT_SECRET="long-random-production-secret"
JWT_EXPIRES_IN="7d"

# Web (Vercel)
NEXT_PUBLIC_API_URL="https://your-api.up.railway.app"
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="long-random-production-secret"
CORS_ORIGINS="https://your-domain.vercel.app"

# Google OAuth (production redirect in Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# X OAuth login (Vercel — same X app, OAuth 2.0 callback /api/auth/callback/twitter)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# X / Twitter (@Bitbro4crypto automation — set in Railway only, never commit)
TWITTER_BEARER_TOKEN=""
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""
X_BRAND_HANDLE="Bitbro4crypto"
PUBLIC_SITE_URL="https://doxxedcrypto.digital"
ADMIN_SYNC_JWT=""
TRENDING_BUY_MIN_TRADERS="5"
TRADER_WIN_MIN_PNL_PERCENT="50"

# Stripe (live or test keys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Solana on-chain top-up (USDC → admin treasury)
# Prefer Helius for production rate limits:
HELIUS_RPC_URL=""
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Optional bootstrap before /admin/platform is configured (also written to PlatformTreasury via bootstrap script)
PLATFORM_SOLANA_TREASURY=""

# Phala Private AI (Step 3 — optional platform-billed Copilot inference on Railway)
PHALA_API_KEY=""
PHALA_INFERENCE_URL="https://api.redpill.ai/v1"
PHALA_MODEL="phala/deepseek-chat-v3-0324"
